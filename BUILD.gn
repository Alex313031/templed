# templed BUILD.gn file.

executable("templed") {
  configs += [ ":templed_config" ]

  precompiled_header = "src/pch.h"
  precompiled_source = "src/pch.h"
  sources = [
    "src/gpio.cc",
    "src/gpio.h",
    "src/pch.h",
    "src/sensors.cc",
    "src/sensors.h",
    "src/templed.cc",
    "src/templed.h",
    "src/utils.cc",
    "src/utils.h",
  ]

  output_name = "templed"
}

config("templed_config") {
  include_dirs = [
    "./src",
    "./wiringpi/wiringPi",
  ]
  cflags_cc = [ "-std=c++17", ]

  # Mirror the Makefile's IS_DEBUG defines; `is_debug` is GN's standard
  # debug-build argument (set with `gn gen --args="is_debug=true"`)
  if (is_debug) {
    defines = [ "DEBUG", "_DEBUG" ]
  } else {
    defines = [ "NDEBUG", "_NDEBUG" ]
  }

  # GN doesn't drive the submodule's Makefile: build libwiringPi.so once
  # beforehand (`make -C wiringpi/wiringPi` plus a libwiringPi.so symlink
  # to the versioned file - or just run the main Makefile once, which does
  # both). Upstream is LGPL v3 and shared-library only; the rpath below
  # lets the runtime loader find the .so in the submodule dir
  lib_dirs = [ "./wiringpi/wiringPi" ]
  libs = [
    "m",
    "wiringPi",
  ]

  # Static C++ runtime + $ORIGIN rpath ("the binary's own directory"), so
  # a shipped templed + libwiringPi.so pair runs from any directory; the
  # second rpath covers running from the build tree
  ldflags = [
    "-static-libstdc++",
    "-static-libgcc",
    "-Wl,-rpath,\$ORIGIN",
    "-Wl,-rpath," + rebase_path("wiringpi/wiringPi"),
  ]
}
